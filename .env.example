# Site URL/name are shared by SSR metadata, prerender, sitemap and CLI scripts.
# Set these before building; rebuild after changing them.
NUXT_PUBLIC_SITE_URL=https://image.tinystool.org
NUXT_PUBLIC_SITE_NAME=Tiny Image
# Add your own public/og-image.png, then set /og-image.png (or an absolute URL).
NUXT_PUBLIC_SITE_IMAGE=

# Analytics and advertising are disabled in this release.
# Enabling them requires a separate privacy/CSP review and an explicit product change.

# Search engine verification. Empty means no verification tags/files.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Optional IndexNow key: 8-128 ASCII letters, digits or hyphens.
# The build creates the public verification file; submission is a separate command.
INDEXNOW_KEY=
